# =============================================================================
# Astro Portal - single operator-facing environment file
# =============================================================================
# First-run flow on any machine with Docker Desktop / Docker Engine + Compose v2:
#
#   git clone <repo> && cd astro-portal
#   cp .env.example .env
#   # edit at minimum SECRET_KEY, SEED_ADMIN_EMAIL, SEED_ADMIN_PASSWORD
#   docker compose up --build
#
# That is the whole first-run experience. No ./scripts/db.sh, no /auth/bootstrap
# curl, no container exec. The backend entrypoint waits for Postgres, runs
# `alembic upgrade head`, seeds the admin if missing, then starts uvicorn.
#
# This file supersedes backend/.env.example for the Docker Compose workflow.
# Local (non-Docker) backend development can still use backend/.env for the
# subset of variables the FastAPI process reads directly.
# =============================================================================


# -----------------------------------------------------------------------------
# REQUIRED on first run
# -----------------------------------------------------------------------------

# Signs JWT tokens. MUST be changed before any non-local use.
SECRET_KEY=change-me-in-production

# First admin account. The backend entrypoint creates this user once and then
# refuses to overwrite it on subsequent runs. Leave both blank to skip seeding
# and use POST /auth/bootstrap instead (allowed until the first admin exists).
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-on-first-login
SEED_ADMIN_NAME=Admin


# -----------------------------------------------------------------------------
# Database (defaults are fine for local dev; Compose wires DATABASE_URL itself)
# -----------------------------------------------------------------------------
POSTGRES_USER=crm_user
POSTGRES_PASSWORD=crm_password
POSTGRES_DB=crm_database

# Async SQLAlchemy URL consumed by the backend. Points to the `db` Compose
# service by default; override only if you connect to an external database.
DATABASE_URL=postgresql+asyncpg://crm_user:crm_password@db:5432/crm_database


# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
ACCESS_TOKEN_EXPIRE_MINUTES=1440
BASE_URL=http://localhost:5174
DOMAIN=localhost

# Comma-separated CORS allow-list. Must include every origin the browser will
# load the app from. Wildcard `*` is rejected when CORS_ALLOW_CREDENTIALS=true.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
CORS_ALLOW_CREDENTIALS=true

# React / Vite dev-server variables (read by frontend-react and frontend when
# their containers start). VITE_BACKEND_URL is the in-cluster backend URL the
# Vite dev-server proxies to; use `http://backend:8000` inside Docker Compose.
# If you run the frontends on your host with `npm run dev`, override to
# `http://localhost:8000`.
VITE_BACKEND_URL=http://backend:8000
VITE_CURRENCY=INR

# Subpath the React app is mounted at. Leave unset (default '/') for the
# direct-port workflow (`docker compose up --build`). Set to `/app/` when
# reverse-proxying via the with-nginx profile so the React app is reachable
# at http://<domain>/app/. Must end with a slash.
# VITE_BASE=/app/


# -----------------------------------------------------------------------------
# Security knobs
# -----------------------------------------------------------------------------
# Public POST /auth/bootstrap endpoint. Automatically no-ops once any active
# admin exists. Set to false for a hard-off in hardened deployments.
BOOTSTRAP_ENDPOINT_ENABLED=true

# Login rate limit per client IP, sliding window. Set MAX_ATTEMPTS=0 to disable.
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900


# -----------------------------------------------------------------------------
# Optional: SMTP (outbound email via aiosmtplib)
# -----------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=


# -----------------------------------------------------------------------------
# Optional: Twilio (outbound WhatsApp)
# -----------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=


# -----------------------------------------------------------------------------
# Optional: Celery (only needed with `docker compose --profile with-celery up`)
# -----------------------------------------------------------------------------
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
