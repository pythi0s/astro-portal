# =============================================================================
# ASTRO PORTAL — PRODUCTION ENVIRONMENT TEMPLATE
# =============================================================================
# Copy this file to .env.production and fill in all REQUIRED values.
# NEVER commit .env.production to version control.
#
# Usage:
#   docker compose -f docker-compose.yml -f docker-compose.prod.yml \
#     --env-file .env.production up -d
#
# To generate a secure SECRET_KEY:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# =============================================================================

# ─────────────────────────────── REQUIRED ────────────────────────────────────

# Must be a cryptographically random 32+ hex chars. NEVER reuse the dev value.
SECRET_KEY=REPLACE_WITH_OUTPUT_OF__python3_-c_"import secrets;print(secrets.token_hex(32))"

# The initial admin account created on first run.
# After the first run this is ignored (seed is idempotent).
SEED_ADMIN_EMAIL=admin@yourdomain.com
SEED_ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD_MIN_16_CHARS
SEED_ADMIN_NAME=Admin

# ─────────────────────────────── DATABASE ────────────────────────────────────

POSTGRES_USER=crm_user
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_DB_PASSWORD
POSTGRES_DB=crm_database
DATABASE_URL=postgresql+asyncpg://crm_user:REPLACE_WITH_STRONG_DB_PASSWORD@db:5432/crm_database

# ─────────────────────────────── APPLICATION ─────────────────────────────────

# Your public domain (no trailing slash, no path)
DOMAIN=yourdomain.com
BASE_URL=https://yourdomain.com

# Shorter expiry for production security (60 min; refresh tokens handle re-auth)
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ─────────────────────────────── CORS ────────────────────────────────────────

# Comma-separated list of allowed origins. Must match your actual domain.
# Include https:// for production; no wildcards when credentials are enabled.
CORS_ORIGINS=https://yourdomain.com
CORS_ALLOW_CREDENTIALS=true

# ─────────────────────────────── FRONTEND ────────────────────────────────────

# In production the frontend is a static build served by nginx.
# VITE_BACKEND_URL is used at build time only; the outer nginx proxies /api/.
VITE_BACKEND_URL=http://backend:8000
VITE_CURRENCY=INR

# ─────────────────────────────── SECURITY ────────────────────────────────────

# MUST be false in production. Bootstrap endpoint is only for first-run.
# Any active admin's existence already prevents the endpoint from seeding,
# but setting this to false closes the route entirely.
ENVIRONMENT=production
BOOTSTRAP_ENDPOINT_ENABLED=false

# Aggressive rate limiting for production (10 attempts per 15 min per IP)
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900

# ─────────────────────────────── CELERY / REDIS ──────────────────────────────

CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ─────────────────────────────── OPTIONAL MESSAGING ─────────────────────────

# SMTP (leave blank to disable email)
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASSWORD=REPLACE_WITH_SMTP_API_KEY
# SMTP_FROM_EMAIL=noreply@yourdomain.com

# Twilio WhatsApp (leave blank to disable)
# TWILIO_ACCOUNT_SID=REPLACE
# TWILIO_AUTH_TOKEN=REPLACE
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
