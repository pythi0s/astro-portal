# Backend URL used by the Vite dev proxy. For Docker Compose, this is set to
# http://backend:8000 by the compose service. For local dev (npm run dev),
# leave as http://localhost:8000.
VITE_BACKEND_URL=http://localhost:8000

# ISO-4217 currency code used by Intl.NumberFormat for all money rendering
# in the Revenue Dashboard. Never hardcode a currency symbol in JSX — drive
# it through this variable so the app works for INR/USD/EUR/etc. without
# code changes.
VITE_CURRENCY=INR
