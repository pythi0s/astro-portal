DATABASE_URL=postgresql+asyncpg://crm_user:crm_password@db:5432/crm_database
SECRET_KEY=change-me-in-production

# Application URL
BASE_URL=http://localhost:5173
DOMAIN=localhost

# CORS: comma-separated origin allow-list. Wildcard is not permitted when
# cors_allow_credentials is true (browsers reject that combination).
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
CORS_ALLOW_CREDENTIALS=true

# Admin seed (idempotent; runs once on startup when no admin exists).
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Admin

# Legacy names still accepted; prefer SEED_ADMIN_* above.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Admin

# Public POST /auth/bootstrap endpoint. Set to false once an admin exists
# and you want hard-off protection even without relying on the runtime check.
BOOTSTRAP_ENDPOINT_ENABLED=true

# Login rate limit — per client IP, sliding window. Set MAX_ATTEMPTS=0 to disable.
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900

# SMTP Configuration (for email sending)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# Twilio Configuration (for WhatsApp messaging)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# Celery / Redis (only needed with --profile with-celery)
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
